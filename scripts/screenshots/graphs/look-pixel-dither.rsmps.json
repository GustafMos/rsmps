{
  "schema": "rsmps/graph",
  "version": 2,
  "name": "Look: pixel art and dither",
  "project": {
    "width": 1920,
    "height": 1080,
    "fps": 24,
    "duration": 4,
    "loop": true,
    "lengthMode": "relative",
    "referenceSide": 1080
  },
  "nodes": [
    {
      "id": "s",
      "type": "media-in",
      "x": 0,
      "y": 0,
      "params": {},
      "label": "Scene"
    },
    {
      "id": "f0",
      "type": "pixelate",
      "x": 280,
      "y": 0,
      "params": {
        "value": 135
      }
    },
    {
      "id": "f1",
      "type": "dither",
      "x": 560,
      "y": 0,
      "params": {
        "algorithm": "bayer-4",
        "strength": 0.6
