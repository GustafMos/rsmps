      },
      "to": {
        "node": "f1",
        "port": "image"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "f1",
        "port": "image"
      },
      "to": {
        "node": "f2",
        "port": "image"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "f2",
        "port": "image"
      },
      "to": {
        "node": "out",
        "port": "image"
      }
    },
    {
      "id": "e5",
