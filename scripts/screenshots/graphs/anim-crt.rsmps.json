      "from": {
        "node": "sc",
        "port": "image"
      },
      "to": {
        "node": "p",
        "port": "image"
      }
    },
    {
      "id": "e33",
      "from": {
        "node": "p",
        "port": "image"
      },
      "to": {
        "node": "d",
        "port": "image"
