{
  "schema": "rsmps/graph",
  "version": 2,
  "name": "Scanned drawing clean-up",
  "project": {
    "width": 1920,
    "height": 1080,
    "fps": 24,
    "duration": 4,
    "loop": true,
    "lengthMode": "relative",
    "referenceSide": 1080
  },
  "nodes": [
    {
      "id": "src",
      "type": "media-in",
      "x": 0,
      "y": 0,
      "params": {},
      "label": "Drop your media here"
    },
    {
      "id": "paper",
      "type": "paper-clean",
      "x": 260,
      "y": 0,
      "params": {
        "paperRadius": 40,
        "guideSuppress": 0.1
      }
    },
    {
      "id": "dust",
      "type": "despeckle",
      "x": 520,
      "y": 0,
      "params": {
        "size": 4
      }
    },
    {
      "id": "ink",
      "type": "line-art",
      "x": 780,
      "y": 0,
      "params": {
        "radius": 24,
        "sensitivity": 0.5,
        "smooth": 1
      }
    },
    {
      "id": "up",
      "type": "upscale-smart",
      "x": 1040,
      "y": 0,
      "params": {
        "mode": "lineart",
        "factor": 2
      }
    },
    {
      "id": "out",
      "type": "image-out",
      "x": 1300,
      "y": 0,
      "params": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "src",
        "port": "image"
      },
      "to": {
        "node": "paper",
        "port": "image"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "paper",
        "port": "image"
      },
      "to": {
        "node": "dust",
        "port": "image"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "dust",
        "port": "image"
      },
      "to": {
        "node": "ink",
        "port": "image"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "ink",
        "port": "image"
      },
      "to": {
        "node": "up",
        "port": "image"
      }
    },
    {
      "id": "e5",
      "from": {
        "node": "up",
        "port": "image"
      },
      "to": {
        "node": "out",
        "port": "image"
      }
    }
  ],
  "frames": []
}
