{
  "schema": "rsmps/graph",
  "version": 2,
  "name": "Halftone print",
  "project": {
    "width": 1920,
    "height": 1080,
    "fps": 24,
    "duration": 4,
    "loop": true,
    "lengthMode": "relative",
    "referenceSide": 1080
  },
  "nodes": [
    {
      "id": "src",
      "type": "media-in",
      "x": 0,
      "y": 0,
      "params": {},
      "label": "Drop your media here"
    },
    {
      "id": "adj",
      "type": "color-adjust",
      "x": 260,
      "y": 0,
      "params": {
        "contrast": 1.2,
        "saturation": 1.15
      }
    },
    {
      "id": "ht",
      "type": "halftone",
      "x": 520,
      "y": 0,
      "params": {
        "mode": "cmyk",
        "dotSize": 8,
        "angle": 25,
        "contrast": 1.1
      }
    },
    {
      "id": "out",
      "type": "image-out",
      "x": 780,
      "y": 0,
      "params": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "src",
        "port": "image"
      },
      "to": {
        "node": "adj",
        "port": "image"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "adj",
        "port": "image"
      },
      "to": {
        "node": "ht",
        "port": "image"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "ht",
        "port": "image"
      },
      "to": {
        "node": "out",
        "port": "image"
      }
    }
  ],
  "frames": []
}
