{
  "schema": "rsmps/graph",
  "version": 2,
  "name": "Composite console (NTSC)",
  "project": {
    "width": 1920,
    "height": 1080,
    "fps": 24,
    "duration": 4,
    "loop": true,
    "lengthMode": "relative",
    "referenceSide": 1080
  },
  "nodes": [
    {
      "id": "src",
      "type": "media-in",
      "x": 0,
      "y": 0,
      "params": {},
      "label": "Drop your media here"
    },
    {
      "id": "pix",
      "type": "pixelate",
      "x": 260,
      "y": 0,
      "params": {
        "mode": "fixed-height",
        "value": 224
      }
    },
    {
      "id": "ntsc",
      "type": "analog-video",
      "x": 520,
      "y": 0,
      "params": {
        "preset": "console"
      }
    },
    {
      "id": "crt",
      "type": "crt-display",
      "x": 780,
      "y": 0,
      "params": {
        "preset": "consumer"
      }
    },
    {
      "id": "out",
      "type": "image-out",
      "x": 1040,
      "y": 0,
      "params": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "src",
        "port": "image"
      },
      "to": {
        "node": "pix",
        "port": "image"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "pix",
        "port": "image"
      },
      "to": {
        "node": "ntsc",
        "port": "image"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "ntsc",
        "port": "image"
      },
      "to": {
        "node": "crt",
        "port": "image"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "crt",
        "port": "image"
      },
      "to": {
        "node": "out",
        "port": "image"
      }
    }
  ],
  "frames": []
}
