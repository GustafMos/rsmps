{
  "schema": "rsmps/graph",
  "version": 2,
  "name": "VHS tape",
  "project": {
    "width": 1920,
    "height": 1080,
    "fps": 24,
    "duration": 4,
    "loop": true,
    "lengthMode": "relative",
    "referenceSide": 1080
  },
  "nodes": [
    {
      "id": "src",
      "type": "media-in",
      "x": 0,
      "y": 0,
      "params": {},
      "label": "Drop your media here"
    },
    {
      "id": "vhs",
      "type": "analog-video",
      "x": 260,
      "y": 0,
      "params": {
        "preset": "vhs",
        "animate": true
      }
    },
    {
      "id": "ca",
      "type": "chromatic-aberration",
      "x": 520,
      "y": 0,
      "params": {
        "amount": 3
      }
    },
    {
      "id": "lines",
      "type": "scanlines",
      "x": 780,
      "y": 0,
      "params": {
        "spacing": 3,
        "strength": 0.18
      }
    },
    {
      "id": "grain",
      "type": "grain",
      "x": 1040,
      "y": 0,
      "params": {
        "amount": 0.14,
        "animated": true
      }
    },
    {
      "id": "vig",
      "type": "vignette",
      "x": 1300,
      "y": 0,
      "params": {
        "amount": 0.4
      }
    },
    {
      "id": "out",
      "type": "image-out",
      "x": 1560,
      "y": 0,
      "params": {}
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "src",
        "port": "image"
      },
      "to": {
        "node": "vhs",
        "port": "image"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "vhs",
        "port": "image"
      },
      "to": {
        "node": "ca",
        "port": "image"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "ca",
        "port": "image"
      },
      "to": {
        "node": "lines",
        "port": "image"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "lines",
        "port": "image"
      },
      "to": {
        "node": "grain",
        "port": "image"
      }
    },
    {
      "id": "e5",
      "from": {
        "node": "grain",
        "port": "image"
      },
      "to": {
        "node": "vig",
        "port": "image"
      }
    },
    {
      "id": "e6",
      "from": {
        "node": "vig",
        "port": "image"
      },
      "to": {
        "node": "out",
        "port": "image"
      }
    }
  ],
  "frames": []
}
