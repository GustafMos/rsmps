{
  "name": "ripscorpy-media-processing-suite",
  "version": "0.41.0",
  "private": false,
  "description": "RipScorpy Media Processing Suite (RSMPS) — a GPU node graph for batch image, video and audio processing: pixel art, palettes, dithering, masks, parallax, tracking, synths and effects.",
  "bin": {
    "rsmps": "dist-cli/rsmps.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "license": "MIT",
  "author": "RipScorpy Media Processing Suite contributors",
  "homepage": "https://github.com/GustafMos/rsmps",
  "repository": {
    "type": "git",
    "url": "https://github.com/GustafMos/rsmps.git"
  },
  "keywords": [
    "pixel-art",
    "dithering",
    "palette",
    "image-processing",
    "video",
    "spritesheet",
    "game-dev",
    "node-graph",
    "webgpu",
    "audio",
    "midi"
  ],
  "scripts": {
    "dev": "vite",
    "dev:lan": "node scripts/dev-lan.mjs",
    "build": "npm run gen && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "npm run gen && tsc --noEmit --pretty",
    "test": "npm run gen && vitest run",
    "test:watch": "vitest",
    "check": "npm run gen && tsc --noEmit && vitest run",
    "cli": "node scripts/build-cli.mjs && node dist-cli/rsmps.mjs",
    "build:cli": "node scripts/build-cli.mjs",
    "desktop:dev": "node desktop/scripts/dev.mjs",
    "desktop:icons": "node desktop/scripts/make-icons.mjs",
    "desktop:build": "node desktop/scripts/pack.mjs",
    "desktop:dist:win": "node desktop/scripts/pack.mjs --win",
    "desktop:dist:mac": "node desktop/scripts/pack.mjs --mac",
    "desktop:dist:linux": "node desktop/scripts/pack.mjs --linux",
    "desktop:smoke": "node desktop/scripts/smoke.mjs",
    "gen": "node scripts/build-cli.mjs gen",
    "desktop:smoke:phone": "node desktop/scripts/smoke.mjs --smoke-phone",
    "desktop:smoke:addons": "node desktop/scripts/smoke.mjs --smoke-addons"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "mediabunny": "^1.65.2",
    "onnxruntime-web": "1.31.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.0",
    "@webgpu/types": "^0.1.74",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "jsqr": "^1.4.0",
    "selfsigned": "^5.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.12",
    "webgpu": "^0.6.2",
    "ws": "^8.23.0"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true,
    "protobufjs@7.6.6": true,
    "webgpu@0.6.2": true
  },
  "overrides": {
    "minimatch@^9.0.0": "^11.0.9",
    "minimatch@^10.0.0": "^11.0.9"
  }
}
